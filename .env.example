# Environment Variables Example for Chargerrr App
# Copy this file to .env and fill in your actual values

# ===== FIREBASE CONFIGURATION =====
# Get these from Firebase Console > Project Settings > General > Your apps
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_WEB_API_KEY=your-web-api-key
FIREBASE_ANDROID_API_KEY=your-android-api-key
FIREBASE_IOS_API_KEY=your-ios-api-key
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID_WEB=your-web-app-id
FIREBASE_APP_ID_ANDROID=your-android-app-id
FIREBASE_APP_ID_IOS=your-ios-app-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_MEASUREMENT_ID=your-measurement-id

# ===== GOOGLE MAPS CONFIGURATION =====
# Get this from Google Cloud Console > APIs & Services > Credentials
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_MAPS_API_KEY_ANDROID=your-android-maps-key
GOOGLE_MAPS_API_KEY_IOS=your-ios-maps-key

# ===== APP CONFIGURATION =====
APP_NAME=Chargerrr
APP_VERSION=1.0.0
APP_BUILD_NUMBER=1
MIN_SUPPORTED_VERSION=1.0.0

# ===== ENVIRONMENT SETTINGS =====
ENVIRONMENT=development  # development, staging, production
DEBUG_MODE=true
ENABLE_LOGGING=true

# ===== API ENDPOINTS =====
# If you have additional REST APIs
API_BASE_URL=https://api.chargerrr.com
API_TIMEOUT=30000

# ===== FEATURE FLAGS =====
ENABLE_PUSH_NOTIFICATIONS=false
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=false
ENABLE_OFFLINE_MODE=false

# ===== THIRD PARTY SERVICES =====
# Payment gateway (if implemented)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key

# Analytics (if implemented)
GOOGLE_ANALYTICS_ID=UA-your-analytics-id
MIXPANEL_PROJECT_TOKEN=your-mixpanel-token

# ===== DEVELOPMENT SETTINGS =====
# For development and testing
TEST_USER_EMAIL=test@chargerrr.com
TEST_USER_PASSWORD=testpassword123
MOCK_LOCATION_LAT=28.6139
MOCK_LOCATION_LNG=77.2090

# ===== SECURITY =====
# Encryption keys (if needed)
ENCRYPTION_KEY=your-encryption-key
JWT_SECRET=your-jwt-secret

# ===== NOTIFICATION SETTINGS =====
FCM_SERVER_KEY=your-fcm-server-key
ONESIGNAL_APP_ID=your-onesignal-app-id

# ===== DATABASE SETTINGS =====
# If using additional databases
POSTGRES_URL=postgresql://user:password@localhost:5432/chargerrr
REDIS_URL=redis://localhost:6379

# ===== FILE STORAGE =====
# If using cloud storage for images
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=chargerrr-images
AWS_REGION=us-west-2

# ===== MONITORING =====
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
NEW_RELIC_LICENSE_KEY=your-newrelic-license-key

# ===== SOCIAL LOGIN (if implemented) =====
GOOGLE_CLIENT_ID=your-google-client-id
FACEBOOK_APP_ID=your-facebook-app-id
APPLE_CLIENT_ID=your-apple-client-id

# ===== RATE LIMITING =====
API_RATE_LIMIT=100  # requests per minute
SEARCH_RATE_LIMIT=50  # searches per minute